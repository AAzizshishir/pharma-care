model Review {
  id         String   @id @default(uuid())
  customerId String
  medicineId String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  customer   User     @relation(fields: [customerId], references: [id])
  medicines  Medicine @relation(fields: [medicineId], references: [id])

  @@index([customerId])
  @@index([medicineId])
  @@map("reviews")
}